      "parameters": {
        "jsCode": "const text = $input.item.json.message.text.toLowerCase();\nconst langMap = {\n  en: ['hello', 'order', 'want', 'need', 'buy', 'please', 'thank'],\n  hi: ['नमस्ते', 'ऑर्डर', 'चाहिए', 'खरीदना'],\n  bn: ['হ্যালো', 'অর্ডার', 'চাই', 'কিনতে'],\n  es: ['hola', 'orden', 'quiero', 'necesito', 'comprar'],\n  ar: ['مرحبا', 'طلب', 'أريد', 'شراء'],\n  fr: ['bonjour', 'commande', 'veux', 'acheter'],\n  zh: ['你好', '订单', '想要', '购买']\n};\n\nlet detectedLang = 'en';\nfor (const [lang, keywords] of Object.entries(langMap)) {\n  if (keywords.some(kw => text.includes(kw))) {\n    detectedLang = lang;\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    chat_id: $input.item.json.message.chat.id,\n    message_text: $input.item.json.message.text,\n    username: $input.item.json.message.chat.username || '',\n    first_name: $input.item.json.message.chat.first_name || '',\n    detectedLang\n  }\n}];"
      },
      "id": "0713b6cd-4c81-4ec0-92d9-c990195368b5",
      "name": "Detect Language",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const orderData = JSON.parse($input.item.json.output);\nconst prevData = $('Detect Language').item.json;\n\nreturn [{\n  json: {\n    ...prevData,\n    ...orderData\n  }\n}];"
      },
