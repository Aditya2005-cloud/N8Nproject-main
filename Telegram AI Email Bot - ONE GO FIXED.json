    {
      "parameters": {
        "jsCode": "const rows = $input.all().filter(r => Object.keys(r.json || {}).length > 0);\nconst nextNum = rows.length + 1;\nconst p = $('Extract Message').item.json;\nreturn [{\n  json: {\n    'SESSION ID': 'No' + nextNum,\n    NAME: p.name,\n    'RECIPIENT EMAIL': '',\n    SUBJECT: '',\n    MESSAGE: '',\n    'AI EMAIL BODY': '',\n    'RECEIVED AT': p.received_at,\n    'TELEGRAM USERNAME': p.telegram_username,\n    'CHAT ID': p.chat_id,\n    STATUS: 'WAITING_EMAIL',\n    'SENT AT': ''\n  }\n}];"
      },
