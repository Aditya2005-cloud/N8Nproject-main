    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst subjectTemplates = {\n  en: `Your Order Confirmation — ${data.order_id}`,\n  hi: `आपके ऑर्डर की पुष्टि — ${data.order_id}`,\n  bn: `আপনার অর্ডার নিশ্চিতকরণ — ${data.order_id}`,\n  es: `Confirmación de su Pedido — ${data.order_id}`,\n  ar: `تأكيد طلبك — ${data.order_id}`,\n  fr: `Confirmation de votre Commande — ${data.order_id}`,\n  zh: `您的订单确认 — ${data.order_id}`\n};\n\nconst htmlBody = `\n<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { text-align: center; margin-bottom: 30px; }\n    .logo { font-size: 24px; font-weight: bold; color: #4CAF50; }\n    table { width: 100%; border-collapse: collapse; margin: 20px 0; }\n    th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }\n    th { background-color: #4CAF50; color: white; }\n    .footer { margin-top: 30px; padding-top: 20px; border-top: 2px solid #ddd; font-size: 12px; color: #666; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <div class=\"logo\">[YOUR STORE LOGO]</div>\n      <h2>Order Confirmation</h2>\n    </div>\n    \n    <p><strong>Order ID:</strong> ${data.order_id}</p>\n    <p><strong>Date:</strong> ${data.timestamp}</p>\n    <p><strong>Customer:</strong> ${data.customer_name || data.first_name}</p>\n    \n    <h3>Order Details</h3>\n    <table>\n      <tr>\n        <th>Product</th>\n        <th>Qty</th>\n        <th>Unit Price</th>\n        <th>Total</th>\n      </tr>\n      <tr>\n        <td>${data.product_name}</td>\n        <td>${data.quantity}</td>\n        <td>$${data.unit_price}</td>\n        <td>$${data.total}</td>\n      </tr>\n    </table>\n    \n    <p><strong>Delivery Address:</strong><br>${data.delivery_address}</p>\n    \n    <h3>Payment Instructions</h3>\n    <p>Please complete payment within 24 hours via:</p>\n    <ul>\n      <li>Bank Transfer: [Your Bank Details]</li>\n      <li>UPI: [Your UPI ID]</li>\n      <li>PayPal: [Your PayPal Link]</li>\n    </ul>\n    <p><strong>Reference:</strong> ${data.order_id}</p>\n    \n    <div class=\"footer\">\n      <p>Thank you for your order!</p>\n      <p>Contact: support@yourstore.com | +1-234-567-8900</p>\n      <p>© 2024 Your Store. All rights reserved.</p>\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    ...data,\n    emailSubject: subjectTemplates[data.detectedLang] || subjectTemplates.en,\n    emailBody: htmlBody\n  }\n}];"
      },
