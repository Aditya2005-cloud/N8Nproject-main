    },
    {
      "parameters": {
        "jsCode": "const s = $('Prepare AI Input').item.json;\nconst ai = $json;\nconst recipient = String(s['RECIPIENT EMAIL'] || '').trim();\nconst subject = String(s.SUBJECT || '').trim();\n\nfunction extractBody(ai) {\n  // OpenAI Responses API shape: { output: [ { content: [ { type: 'output_text', text: '...' } ] } ] }\n  if (Array.isArray(ai.output)) {\n    for (const item of ai.output) {\n      if (Array.isArray(item.content)) {\n        for (const c of item.content) {\n          if (c && typeof c.text === 'string' && c.text.trim()) return c.text;\n        }\n      }\n    }\n  }\n  // Fallbacks for other possible simplified shapes\n  if (typeof ai.output_text === 'string' && ai.output_text.trim()) return ai.output_text;\n  if (typeof ai.content === 'string' && ai.content.trim()) return ai.content;\n  if (typeof ai.text === 'string' && ai.text.trim()) return ai.text;\n  return '';\n}\n\nconst body = extractBody(ai).trim();\n\nif (!recipient || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(recipient)) {\n  throw new Error(`Recipient email is missing or invalid: ${recipient}`);\n}\nif (!subject) throw new Error('Email subject is empty.');\nif (!body) throw new Error('AI generated email body is empty.');\n\nreturn [{ json: { ...s, recipient_email: recipient, subject, email_body: body } }];"
      },
