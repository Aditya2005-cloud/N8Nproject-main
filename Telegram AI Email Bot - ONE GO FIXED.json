      "parameters": {
        "jsCode": "const m = $json.message || {};\nconst text = (m.text || '').trim();\nreturn [{\n  json: {\n    name: [m.from?.first_name, m.from?.last_name].filter(Boolean).join(' '),\n    telegram_username: m.from?.username || '',\n    chat_id: String(m.chat?.id || ''),\n    text: text,\n    is_start: text.toLowerCase() === '/start',\n    received_at: $now.toISO()\n  }\n}];"
      },
